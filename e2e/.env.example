# Playwright E2E environment
#
# Copy this file to e2e/.env.local (gitignored) and fill in a DISPOSABLE
# Supabase project. Never point these values at production.
#
# Local Supabase (`supabase start`) values are printed by:
#   supabase status -o env
#
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=<local anon key>
# E2E_SUPABASE_SERVICE_ROLE_KEY=<local service-role key>
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_DATABASE_SSL=false
#
# App URLs. The defaults match `pnpm test:e2e` in a local checkout.
# E2E_BASE_URL=http://127.0.0.1:5174
# E2E_API_URL=http://127.0.0.1:3100/api
#
# Optional: test identities created/updated by e2e/seed.ts. The defaults are
# deterministic and safe for a disposable project.
# E2E_HEAD_EMAIL=e2e.head@example.com
# E2E_HEAD_PASSWORD=E2e!Passw0rd
# E2E_DEAN_EMAIL=e2e.dean@example.com
# E2E_DEAN_PASSWORD=E2e!Passw0rd
#
# Set to 1 when the frontend/backend are already running against this test
# project (for example a dedicated hosted environment). The seed still runs.
# E2E_SKIP_WEBSERVER=1
