{
  "name": "wmsu-coe-nnect",
  "version": "0.1.0",
  "private": true,
  "description": "CoE-NNECT: College of Engineering Scheduling System (WMSU)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:no-solver": "node scripts/dev.mjs --no-solver",
    "dev:no-parser": "node scripts/dev.mjs --no-parser",
    "dev:backend": "node scripts/dev.mjs --only=backend",
    "dev:frontend": "node scripts/dev.mjs --only=frontend",
    "dev:solver": "node scripts/dev.mjs --only=solver",
    "dev:parser": "node scripts/dev.mjs --only=parser",
    "dev:web": "pnpm --parallel --filter \"./apps/*\" dev",
    "setup:venvs": "powershell -ExecutionPolicy Bypass -File scripts/setup-venvs.ps1",
    "kill": "powershell -NoProfile -Command \"try { Get-NetTCPConnection -LocalPort 3000,5173,8000,8001 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } } catch {} ; exit 0\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:list": "playwright test --config e2e/playwright.config.ts --list",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}