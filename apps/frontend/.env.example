# ─────────────────────────────────────────────────
# CoE-NNECT Frontend — Environment Template
# Copy to .env.local and fill in the values
# ─────────────────────────────────────────────────

# Backend API base URL
# Local: http://localhost:3000/api
# LAN (phone testing): http://192.168.1.4:3000/api
# Production: https://your-backend.up.railway.app/api
VITE_API_BASE_URL=http://localhost:3000/api

# Supabase — API credentials
# Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Dev login popup credentials (optional — hidden if empty)
# These appear in the Dev Login panel in development mode only
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
VITE_DEV_HEAD_EMAIL=
VITE_DEV_HEAD_PASSWORD=