{
  "name": "@coe-nnect/backend",
  "version": "0.1.0",
  "private": true,
  "description": "CoE-NNECT Scheduling System - Backend API",
  "scripts": {
    "predev": "pnpm --filter @coe-nnect/constraint-rules build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @coe-nnect/constraint-rules build",
    "build": "nest build",
    "start": "nest start",
    "seed:demo": "ts-node -r tsconfig-paths/register src/database/seeds/demo-seed.ts",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "db:reset": "ts-node -r tsconfig-paths/register -r dotenv/config src/database/seeds/reset.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.spec.json",
    "reset:demo": "ts-node -r tsconfig-paths/register src/database/seeds/reset.ts"
  },
  "dependencies": {
    "@coe-nnect/constraint-rules": "workspace:*",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "11",
    "@nestjs/config": "4",
    "@nestjs/core": "11",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^1.2.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "11",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "@supabase/supabase-js": "^2.117.2",
    "axios": "^1.7.3",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vercel/node": "^17.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}