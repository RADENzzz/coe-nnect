# ─────────────────────────────────────────────────
# CoE-NNECT Backend — Environment Template
# Copy to .env and fill in the values
# ─────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Supabase — Session pooler connection (port 5432)
# Get from: Supabase Dashboard → Connect → ORM → Session pooler
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Note: URL-encode special chars in the password (@ → %40, # → %23, etc.)
DATABASE_URL=

# Set to false for a local Supabase/Postgres stack without TLS.
# Omit (or set true) for hosted Supabase.
# DATABASE_SSL=false

# Supabase — API credentials
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS — Comma-separated list of allowed frontend origins
# Include dev (localhost + LAN IP) and production URLs.
# Production accepts only these exact origins; wildcards and LAN IPs outside
# this list are rejected.
FRONTEND_URL=http://localhost:5173,http://192.168.1.4:5173
CORS_ALLOWED_ORIGINS=
PROSPECTUS_PARSER_URL=http://localhost:8001

# Reverse proxy / rate limiting
# Set TRUST_PROXY=true only behind a trusted proxy. Vercel deployments enable
# it automatically. TRUST_PROXY may also be a number of trusted hops.
# THROTTLE_TTL_MS is the global window; LOGIN_THROTTLE_LIMIT is requests/min.
# TRUST_PROXY=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=10

# Logging — set LOG_FORMAT=json to force JSON logs outside production
# LOG_FORMAT=json

# Swagger — outside production it is always available. Production requires
# all three values below; otherwise the docs routes are not mounted.
ENABLE_SWAGGER=false
SWAGGER_USER=
SWAGGER_PASSWORD=
