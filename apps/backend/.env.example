# ─────────────────────────────────────────────────
# CoE-NNECT Backend — Environment Template
# Copy to .env and fill in the values
# ─────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Local-only: ignore system_status.maintenance_mode while developing.
# Only honored when NODE_ENV=development; never set it in production.
# MAINTENANCE_BYPASS=true

# Supabase — Session pooler connection (port 5432)
# Get from: Supabase Dashboard → Connect → ORM → Session pooler
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Note: URL-encode special chars in the password (@ → %40, # → %23, etc.)
DATABASE_URL=

# Set to false for a local Supabase/Postgres stack without TLS.
# Omit (or set true) for hosted Supabase.
# DATABASE_SSL=false

# Supabase — API credentials
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS — Comma-separated list of allowed frontend origins
# Include dev (localhost + LAN IP) and production URLs.
# Production accepts only these origins; entries may be exact
# (https://coe.example.edu) or use a leading subdomain wildcard
# (https://*.trycloudflare.com).
FRONTEND_URL=http://localhost:5173,http://192.168.1.4:5173
CORS_ALLOWED_ORIGINS=

# Cloudflare quick tunnel (temporary demo link) — accepts the rotating
# https://<random>.trycloudflare.com origins. Outside production this is
# already allowed, so `pnpm dev` + `pnpm online` needs no configuration.
# In production it must be turned on explicitly (demos only — anyone with the
# tunnel URL reaches the API, and valid logins pass).
CORS_ALLOW_TUNNEL=false

PROSPECTUS_PARSER_URL=http://localhost:8001

# Reverse proxy / rate limiting
# Set TRUST_PROXY=true only behind a trusted proxy. The Railway IaC sets
# TRUST_PROXY=1 because the frontend proxy is one hop in front of the backend.
# TRUST_PROXY may also be a number of trusted hops.
# Cloudflare Tunnel forwards the client address, so use TRUST_PROXY=true when
# the backend is reached through cloudflared.
# THROTTLE_TTL_MS is the global window; LOGIN_THROTTLE_LIMIT is requests/min.
# TRUST_PROXY=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
LOGIN_THROTTLE_LIMIT=10

# Cap CAPTCHA (Cap Core) — signs challenge JWTs and verifies the login widget.
# Must be at least 16 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never expose this value to the frontend.
CAP_SECRET=
# Requests/min per IP for /api/v1/auth/cap (challenge + redeem). Default 60.
CAP_THROTTLE_LIMIT=60

# Requests/15 min per IP for /api/v1/recovery (request/verify/reset). Default 10.
RECOVERY_THROTTLE_LIMIT=10

# ─────────────────────────────────────────────────────────────
# Transactional email (Mox or any SMTP submission server)
# ─────────────────────────────────────────────────────────────
# Optional recovery email + password reset links are sent through this SMTP
# account. Leave SMTP_HOST/SMTP_FROM empty to disable the feature; the rest of
# the app still starts normally.
#
# Mox quickstart example:
#   SMTP_HOST=mail.example.edu
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=no-reply@example.edu
#   SMTP_PASSWORD=<mailbox password>
#   SMTP_FROM="CoE-NNECT <no-reply@example.edu>"
#
# APP_PUBLIC_URL is the frontend origin used in verification/reset links.
# If omitted, the first FRONTEND_URL entry is used (localhost:5173 in dev).
# APP_PUBLIC_URL=https://coe-nnect.example.edu
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Keep TLS certificate verification on in production. Set to false only for a
# local Mox instance with a self-signed certificate.
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Logging — set LOG_FORMAT=json to force JSON logs outside production
# LOG_FORMAT=json

# Swagger — outside production it is always available. Production requires
# all three values below; otherwise the docs routes are not mounted.
ENABLE_SWAGGER=false
SWAGGER_USER=
SWAGGER_PASSWORD=

# ─────────────────────────────────────────────────
# IDP integration (CoE-NNECT <-> Institutional Data Platform)
# ─────────────────────────────────────────────────
# Pattern C (primary): the IDP desktop app pushes faculty snapshots to
# POST /api/idp/v1/inbox/faculty and polls GET /api/idp/v1/outbox/schedules.
# Pattern A (fallback): CoE-NNECT calls IDP's REST API for pulls/pushes.

# Master switch for Pattern A outbound pulls and the "Refresh from IDP" action.
IDP_ENABLED=false

# Base URL of the IDP REST API (no trailing slash). Only needed for Pattern A.
IDP_BASE_URL=

# Bearer token used for outbound Pattern A requests. Never commit the real value.
IDP_API_KEY=

# Per-device bearer key the IDP desktop presents on Pattern C inbox/outbox
# calls: Authorization: Bearer <IDP_DEVICE_API_KEY>. Inbound readiness requires
# this value plus IDP_WEBHOOK_SECRET.
IDP_DEVICE_API_KEY=

# Shared secret used to verify inbound HMAC-SHA256 webhook signatures.
IDP_WEBHOOK_SECRET=

# Outbound request timeout in milliseconds (default 15000).
IDP_REQUEST_TIMEOUT_MS=15000

# Allowed clock skew for X-IDP-Timestamp, in milliseconds (default 5 minutes).
IDP_WEBHOOK_TOLERANCE_MS=300000

