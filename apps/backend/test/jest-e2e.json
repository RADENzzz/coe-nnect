{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.spec.json",
        "diagnostics": {
          "ignoreCodes": [151002]
        }
      }
    ]
  },
  "clearMocks": true,
  "restoreMocks": true,
  "testTimeout": 30000
}
